{
  "name": "pomo",
  "version": "1.0.0",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', {recursive: true, force: true}) \"",
    "build": "npm run clean && tsc -p ./tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "start": "npm run build && node lib/cli.js"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
